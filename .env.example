# Skopiuj do `.env` i dostosuj. `.env` jest w .gitignore — nigdy nie commituj sekretów.
# Zmienne są walidowane przy starcie API (Zod) od Fazy 1 — brak/nieprawidłowa wartość = fail-fast.

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Baza (docker-compose: usługa postgres) ---
# POSTGRES_PORT zmienia port hosta, jeśli 5432 jest zajęty (np. inny projekt). Domyślnie 5432.
# POSTGRES_PORT=5432
DATABASE_URL=postgres://app:app@localhost:5432/app

# --- Mail (docker-compose: usługa mailhog; adapter dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.com

# --- Error tracking (Sentry; puste = adapter no-op w dev) ---
SENTRY_DSN=

# --- CORS: web + admin na osobnych originach (spec sekcja 3/7) ---
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# --- Auth ---
# JWT_SECRET: wymagany, min 32 znaki. Wygeneruj np. `openssl rand -hex 32`. NIE commituj prawdziwego.
JWT_SECRET=dev-only-secret-change-me-min-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN: dla admina na subdomenie ustaw np. .example.com (współdzielenie cookie z api).
# COOKIE_DOMAIN=
# COOKIE_SECURE: true na produkcji (HTTPS).
COOKIE_SECURE=false
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# --- Docker full-stack (tylko dla `pnpm docker:full` / `docker:dev`) ---
# Cała apka w kontenerach (API + web + admin + Postgres + mailhog). Compose czyta ten plik.
# Porty hosta (nadpisz przy kolizji z innymi projektami). W kontenerze API zawsze 3000, web/admin
# nginx :80 (prod) / vite (dev) — mapowane na poniższe porty hosta.
# API_PORT=3000
# WEB_PORT=5173
# ADMIN_PORT=5174
# JWT_SECRET jest współdzielony z sekcją Auth powyżej. Na potrzeby kontenerów DATABASE_URL/SMTP_HOST
# ustawia compose (postgres/mailhog jako nazwy usług) — nie ruszaj tutaj.
# Przepis: docs/recipes/jak-uruchomic-w-dockerze.md
