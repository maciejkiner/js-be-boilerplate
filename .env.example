# Skopiuj do `.env` i dostosuj. `.env` jest w .gitignore — nigdy nie commituj sekretów.
# Zmienne są walidowane przy starcie API (Zod) od Fazy 1 — brak/nieprawidłowa wartość = fail-fast.

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Baza (docker-compose: usługa postgres) ---
# POSTGRES_PORT zmienia port hosta, jeśli 5432 jest zajęty (np. inny projekt). Domyślnie 5432.
# POSTGRES_PORT=5432
DATABASE_URL=postgres://app:app@localhost:5432/app

# --- Mail (docker-compose: usługa mailhog; adapter dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Error tracking (Sentry; puste = adapter no-op w dev) ---
SENTRY_DSN=

# --- CORS: web + admin na osobnych originach (spec sekcja 3/7) ---
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
